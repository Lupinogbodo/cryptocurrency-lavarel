################################################################################
# CRYPTOCURRENCY TRADING API - Configuration
################################################################################

# Application Settings
APP_NAME="Crypto Trading API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance
APP_MAINTENANCE_DRIVER=file

################################################################################
# SECURITY & SESSIONS
################################################################################

BCRYPT_ROUNDS=12
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

################################################################################
# DATABASE - PostgreSQL (Production) / SQLite (Local Development)
################################################################################

# For PostgreSQL (Recommended for production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=crypto_trading
DB_USERNAME=admin
DB_PASSWORD=password

# For local SQLite development (uncomment to use)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

################################################################################
# CRYPTO TRADING API SPECIFIC
################################################################################

# CoinGecko API Integration
# Sign up at: https://www.coingecko.com/en/api
# Free tier is sufficient for development
COINGECKO_API_KEY=
VERIFY_SSL=true

# Supported Cryptocurrencies: BTC, ETH, USDT
# Fee Structure:
# - Buy trades: 2.0% fee (applied to purchase amount)
# - Sell trades: 2.0% fee (deducted from proceeds)
# - Minimum transaction: ₦5,000 in Naira
# - USD to NGN conversion rate: 1550 (fallback when NGN rate unavailable)

################################################################################
# LOGGING
################################################################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

################################################################################
# CACHE & STORAGE
################################################################################

CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# CoinGecko rate caching (in minutes)
CACHE_PREFIX=crypto_trading_

# Optional: Memcached configuration
# MEMCACHED_HOST=127.0.0.1

################################################################################
# OPTIONAL: REDIS (for production caching/sessions)
################################################################################

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

################################################################################
# OPTIONAL: EMAIL CONFIGURATION
################################################################################

# MAIL_MAILER=log
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

################################################################################
# OPTIONAL: AWS S3 (for file storage)
################################################################################

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

################################################################################
# FRONTEND (Vite)
################################################################################

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}/api"

################################################################################
# BROADCAST & NOTIFICATIONS (Optional)
################################################################################

BROADCAST_CONNECTION=log
